<%- include('../partials/head', { title: 'Satış' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-7">
      <div class="card p-3 mb-3">
        <label class="form-label">Ad üzrə axtar</label>
        <input type="text" id="name-search" class="form-control" autofocus placeholder="Mal adı...">
        <div id="search-results" class="list-group mt-2"></div>
      </div>
      <div class="card p-3 mb-3">
        <label class="form-label">Və ya barkodu skan edin/daxil edin</label>
        <div class="input-group">
          <input type="text" id="barcode-input" class="form-control" placeholder="Barkod...">
          <button type="button" class="btn btn-outline-primary" id="camera-scan-btn">
            <i class="bi bi-camera-fill"></i> Kamera ilə skan et
          </button>
        </div>
        <div id="scan-error" class="text-danger mt-2"></div>
      </div>
      <% if (quickProducts && quickProducts.length) { %>
      <div class="card p-3">
        <label class="form-label mb-2"><i class="bi bi-lightning-charge-fill text-warning"></i> Tez satış — ən çox satılan mallar</label>
        <div class="quick-pick-grid">
          <% quickProducts.forEach(p => { %>
          <button type="button" class="quick-pick-btn"
            data-id="<%= p.id %>" data-name="<%= p.name %>" data-unit="<%= p.unit %>"
            data-price="<%= p.salePrice %>" data-qty="<%= p.quantity %>">
            <span class="quick-pick-name"><%= p.name %></span>
            <span class="quick-pick-price"><%= money(p.salePrice) %> ₼</span>
          </button>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

    <div class="col-lg-5">
      <div class="card p-3">
        <h5>Səbət</h5>
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Mal</th><th>Miqdar</th><th>Qiymət</th><th>Endirim</th><th>Cəm</th><th></th></tr></thead>
            <tbody id="cart-body"></tbody>
          </table>
        </div>
        <h4 class="text-end">Yekun: <span id="cart-total">0.00</span> ₼</h4>
        <div class="mb-3">
          <label class="form-label">Qeyd (könüllü)</label>
          <input type="text" id="sale-note" class="form-control" placeholder="Məs: müştəri qeydi...">
        </div>
        <div class="d-grid gap-2">
          <button class="btn btn-success btn-lg" onclick="openPayModal('CASH')"><i class="bi bi-cash-stack"></i> Nağd ödə</button>
          <button class="btn btn-primary btn-lg" onclick="openPayModal('CARD')"><i class="bi bi-credit-card"></i> Kartla ödə</button>
          <button class="btn btn-info btn-lg text-white" onclick="openPayModal('TRANSFER')"><i class="bi bi-bank"></i> Köçürmə ilə ödə</button>
          <button class="btn btn-warning btn-lg" onclick="openPayModal('DEBT')"><i class="bi bi-journal-text"></i> Borca yaz</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Odeme modal -->
<div class="modal" id="pay-modal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="pay-modal-title">Ödəniş</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Yekun məbləğ: <strong id="pay-modal-total"></strong> ₼</p>
        <div id="customer-section" style="display:none;">
          <label class="form-label">Müştəri (ad ilə axtar və ya yeni yaradın)</label>
          <input type="text" id="customer-search" class="form-control mb-1" placeholder="Müştəri adı və ya nömrə">
          <div id="customer-results" class="list-group mb-2"></div>
          <div id="selected-customer" class="alert alert-info py-1" style="display:none;"></div>
          <div id="new-customer-fields">
            <input type="hidden" id="selected-customer-id">
            <label class="form-label">Yeni müştəri adı</label>
            <input type="text" id="new-customer-name" class="form-control mb-2">
            <label class="form-label">Telefon (könüllü)</label>
            <input type="text" id="new-customer-phone" class="form-control">
          </div>
        </div>
        <div id="pay-error" class="text-danger mt-2"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">İmtina</button>
        <button class="btn btn-primary" onclick="submitCheckout()">Təsdiqlə</button>
      </div>
    </div>
  </div>
</div>

<!-- Kamera ile skan modal -->
<div class="modal" id="scan-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Barkodu kameraya tutun</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <video id="scan-video" autoplay playsinline muted style="width:100%; border-radius:8px; background:#000;"></video>
        <div id="scan-modal-status" class="text-muted mt-2"></div>
        <div id="scan-modal-last" class="alert alert-success mt-2" style="display:none;"></div>
      </div>
    </div>
  </div>
</div>

<script src="/js/pos.js?v=<%= assetVersion %>"></script>
<%- include('../partials/foot') %>
