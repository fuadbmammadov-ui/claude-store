<%- include('../partials/head', { title: 'Hədəflər' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <h3>Hədəflər — <%= monthLabel %></h3>
  <%- include('../reports/_subnav', { active: 'targets' }) %>

  <form method="get" class="mb-4" style="max-width: 220px;">
    <input type="month" name="month" value="<%= monthValue %>" class="form-control" onchange="this.form.submit()">
  </form>

  <% if (target && target.isDefault) { %>
  <div class="alert alert-info">Bu ay üçün hədəf təyin edilməyib — əvvəlki ayın dəyərləri göstərilir (defolt). Yadda saxlasanız bu ay üçün ayrıca saxlanılacaq.</div>
  <% } else if (!target) { %>
  <div class="alert alert-secondary">Bu ay və əvvəlki ay üçün heç bir hədəf təyin edilməyib.</div>
  <% } %>

  <form method="post" action="/targets" class="card p-4" style="max-width: 480px;">
    <input type="hidden" name="year" value="<%= year %>">
    <input type="hidden" name="month" value="<%= month %>">
    <div class="mb-3">
      <label class="form-label">Satış hədəfi (₼, aylıq)</label>
      <input type="number" step="0.01" min="0" name="salesTarget" class="form-control" value="<%= target ? target.salesTarget : '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Ümumi mənfəət hədəfi (%)</label>
      <input type="number" step="0.1" min="0" max="100" name="grossMarginTargetPct" class="form-control" value="<%= target ? target.grossMarginTargetPct : '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Orta çek hədəfi (₼)</label>
      <input type="number" step="0.01" min="0" name="avgTicketTarget" class="form-control" value="<%= target ? target.avgTicketTarget : '' %>" required>
    </div>
    <button type="submit" class="btn btn-primary">Yadda saxla</button>
  </form>

  <h6 class="mt-5">Keçmiş hədəflər</h6>
  <div class="table-responsive" style="max-width: 560px;">
  <table class="table table-sm bg-white">
    <thead><tr><th>Ay</th><th>Satış hədəfi</th><th>Marja %</th><th>Orta çek</th></tr></thead>
    <tbody>
      <% allTargets.forEach(t => { %>
      <tr>
        <td><a href="/targets?month=<%= t.year %>-<%= String(t.month).padStart(2,'0') %>"><%= AZ_MONTH_NAMES[t.month - 1] %> <%= t.year %></a></td>
        <td><%= money(t.salesTarget) %> ₼</td>
        <td><%= Number(t.grossMarginTargetPct).toFixed(1) %>%</td>
        <td><%= money(t.avgTicketTarget) %> ₼</td>
      </tr>
      <% }) %>
      <% if (!allTargets.length) { %>
      <tr><td colspan="4" class="text-center text-muted py-3">Hələ hədəf təyin edilməyib</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/foot') %>
