<%- include('partials/head', { title: 'Panel' }) %>
<%- include('partials/nav') %>
<div class="container-fluid py-4">
  <h3>Bugünkü vəziyyət</h3>

  <% if (!openSession) { %>
  <div class="alert alert-warning">Kassa açıq deyil. <a href="/cash-sessions">Kassanı açın</a>.</div>
  <% } %>

  <% if (currentUser.role === 'ADMIN') { %>
  <div class="row g-3 mb-4">
    <div class="col-md-2">
      <a href="/today-sales?type=CASH" class="card p-3 text-center text-decoration-none text-reset h-100">
        <div class="text-muted small">Nağd satış</div>
        <div class="fs-5 fw-bold"><%= money(cashTotal) %> ₼</div>
        <div class="text-muted small"><%= cashCount %> satış</div>
      </a>
    </div>
    <div class="col-md-2">
      <a href="/today-sales?type=CARD" class="card p-3 text-center text-decoration-none text-reset h-100">
        <div class="text-muted small">Kartla satış</div>
        <div class="fs-5 fw-bold"><%= money(cardTotal) %> ₼</div>
        <div class="text-muted small"><%= cardCount %> satış</div>
      </a>
    </div>
    <div class="col-md-2">
      <a href="/today-sales?type=TRANSFER" class="card p-3 text-center text-decoration-none text-reset h-100">
        <div class="text-muted small">Köçürmə</div>
        <div class="fs-5 fw-bold"><%= money(transferTotal) %> ₼</div>
        <div class="text-muted small"><%= transferCount %> satış</div>
      </a>
    </div>
    <div class="col-md-2">
      <a href="/today-sales?type=DEBT" class="card p-3 text-center text-decoration-none text-reset h-100">
        <div class="text-muted small">Borca yazılan</div>
        <div class="fs-5 fw-bold text-danger"><%= money(debtTotal) %> ₼</div>
        <div class="text-muted small"><%= debtCount %> satış</div>
      </a>
    </div>
    <div class="col-md-2">
      <div class="card p-3 text-center">
        <div class="text-muted small">Bugünkü qazanc</div>
        <div class="fs-5 fw-bold text-success"><%= money(profitToday) %> ₼</div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card p-3 text-center">
        <div class="text-muted small">Təchizatçı borcumuz</div>
        <div class="fs-5 fw-bold text-danger"><%= money(supplierDebtTotal) %> ₼</div>
      </div>
    </div>
  </div>
  <% } %>

  <div class="d-flex gap-2 mb-4">
    <a href="/pos" class="btn btn-primary btn-lg">Satışa başla</a>
    <a href="/products/new" class="btn btn-outline-secondary btn-lg">Mal qəbulu</a>
    <a href="/expenses/new" class="btn btn-outline-secondary btn-lg">Xərc yaz</a>
  </div>

  <% if (currentUser.role === 'ADMIN') { %>
  <hr class="my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Aylıq maliyyə göstəriciləri</h4>
    <form method="get" class="d-flex gap-2">
      <select name="month" class="form-select" onchange="this.form.submit()">
        <% for (let m = 1; m <= 12; m++) { %>
        <option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %></option>
        <% } %>
      </select>
      <select name="year" class="form-select" onchange="this.form.submit()">
        <% for (let y = year - 2; y <= year + 1; y++) { %>
        <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
        <% } %>
      </select>
    </form>
  </div>

  <div class="alert <%= monthNetProfit >= 0 ? 'alert-success' : 'alert-danger' %> fw-bold">
    Mağaza vəziyyəti: <%= monthNetProfit >= 0 ? '✓ MƏNFƏƏTLƏ İŞLƏYİR' : '✗ ZƏRƏRLƏ İŞLƏYİR' %>
    (<%= month %>.<%= year %>)
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Aylıq satış</div>
        <div class="fs-5 fw-bold"><%= money(monthRevenue) %> ₼</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Ümumi mənfəət (marja)</div>
        <div class="fs-5 fw-bold"><%= money(monthGrossProfit) %> ₼</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Xərclər</div>
        <div class="fs-5 fw-bold text-danger"><%= money(monthExpenseTotal) %> ₼</div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Net mənfəət</div>
        <div class="fs-5 fw-bold <%= monthNetProfit >= 0 ? 'text-success' : 'text-danger' %>"><%= money(monthNetProfit) %> ₼</div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card p-3">
        <h6>Ən çox satılan mallar (məbləğ üzrə)</h6>
        <table class="table table-sm mb-0">
          <thead><tr><th>Mal</th><th>Miqdar</th><th>Satış</th></tr></thead>
          <tbody>
            <% topSelling.forEach(p => { %>
            <tr><td><%= p.name %></td><td><%= p.qty.toFixed(2) %></td><td><%= money(p.revenue) %> ₼</td></tr>
            <% }) %>
            <% if (!topSelling.length) { %><tr><td colspan="3" class="text-center text-muted">Məlumat yoxdur</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card p-3">
        <h6>Ən çox mənfəət gətirən mallar</h6>
        <table class="table table-sm mb-0">
          <thead><tr><th>Mal</th><th>Mənfəət</th></tr></thead>
          <tbody>
            <% topProfit.forEach(p => { %>
            <tr><td><%= p.name %></td><td><%= money(p.profit) %> ₼</td></tr>
            <% }) %>
            <% if (!topProfit.length) { %><tr><td colspan="2" class="text-center text-muted">Məlumat yoxdur</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

  <% if (lowStockList.length) { %>
  <h5>Azalan mallar</h5>
  <table class="table bg-white">
    <thead><tr><th>Mal</th><th>Qalıq</th><th>Minimum</th></tr></thead>
    <tbody>
      <% lowStockList.forEach(p => { %>
      <tr>
        <td><a href="/products/<%= p.id %>"><%= p.name %></a></td>
        <td><%= qty(p.quantity, p.unit) %></td>
        <td><%= qty(p.minStock, p.unit) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('partials/foot') %>
