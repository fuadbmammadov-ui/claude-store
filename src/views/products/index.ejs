<%- include('../partials/head', { title: 'Mallar' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mallar</h3>
    <div class="d-flex gap-2">
      <a href="/products/bulk-new" class="btn btn-outline-primary">Siyahı ilə əlavə et</a>
      <a href="/products/new" class="btn btn-primary">+ Yeni mal / Mal qəbulu</a>
    </div>
  </div>

  <% if (bulkAdded) { %>
  <div class="alert alert-success"><%= bulkAdded %> mal siyahıdan uğurla əlavə edildi.</div>
  <% } %>

  <form class="row g-2 mb-3" method="get" action="/products">
    <div class="col-md-8">
      <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Ad və ya barkod üzrə axtar...">
    </div>
    <div class="col-md-3">
      <select name="category" class="form-select" onchange="this.form.submit()">
        <option value="">Bütün kateqoriyalar</option>
        <% categories.forEach(c => { %>
        <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-1">
      <button type="submit" class="btn btn-outline-secondary w-100">Axtar</button>
    </div>
  </form>

  <div class="table-responsive">
    <table class="table table-hover bg-white">
      <thead>
        <tr>
          <th>Ad</th>
          <th>Kateqoriya</th>
          <th>Barkod</th>
          <th>Ölçü</th>
          <th>Alış qiyməti</th>
          <th>Satış qiyməti</th>
          <th>Qalıq</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
        <tr class="<%= p.minStock && Number(p.quantity) <= Number(p.minStock) ? 'table-warning' : '' %>">
          <td>
            <a href="/products/<%= p.id %>"><%= p.name %></a>
          </td>
          <td><%= p.category || '-' %><% if (p.subCategory) { %> / <%= p.subCategory %><% } %></td>
          <td><code><%= p.barcode %></code></td>
          <td><%= p.unit === 'KG' ? 'kq' : 'ədəd' %></td>
          <td><%= money(p.purchasePrice) %> ₼</td>
          <td><%= money(p.salePrice) %> ₼</td>
          <td><%= qty(p.quantity, p.unit) %> <%= p.unit === 'KG' ? 'kq' : 'ədəd' %></td>
          <td class="text-end">
            <a href="/products/<%= p.id %>/receive" class="btn btn-sm btn-outline-success">Mal qəbulu</a>
            <a href="/products/<%= p.id %>/label" class="btn btn-sm btn-outline-secondary">Barkod çap</a>
          </td>
        </tr>
        <% }) %>
        <% if (!products.length) { %>
        <tr><td colspan="8" class="text-center text-muted py-4">Mal tapılmadı</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/foot') %>
