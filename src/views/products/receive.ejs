<%- include('../partials/head', { title: 'Mal qəbulu' }) %>
<%- include('../partials/nav') %>
<div class="container py-4" style="max-width: 560px;">
  <h3>Mal qəbulu: <%= product.name %></h3>
  <p class="text-muted">Hazırkı qalıq: <%= qty(product.quantity, product.unit) %> <%= product.unit === 'KG' ? 'kq' : 'ədəd' %></p>
  <form method="post" action="/products/<%= product.id %>/receive" class="card p-4">
    <div class="mb-3">
      <label class="form-label">Qəbul olunan miqdar (<%= product.unit === 'KG' ? 'kq' : 'ədəd' %>)</label>
      <input type="number" step="0.001" min="0.001" name="quantity" class="form-control" required autofocus>
    </div>
    <div class="mb-3">
      <label class="form-label">Alış qiyməti (₼)</label>
      <input type="number" step="0.01" min="0" name="purchasePrice" class="form-control" value="<%= product.purchasePrice %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Yeni satış qiyməti (₼) <span class="text-muted">(dəyişmək istəmirsinizsə boş saxlayın)</span></label>
      <input type="number" step="0.01" min="0" name="salePrice" class="form-control" placeholder="<%= product.salePrice %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Təchizatçı (könüllü)</label>
      <input type="text" name="supplierName" class="form-control">
    </div>
    <button type="submit" class="btn btn-success">Mal qəbulunu təsdiqlə</button>
  </form>
</div>
<%- include('../partials/foot') %>
