<%- include('../partials/head', { title: product ? 'Malı redaktə et' : 'Yeni mal' }) %>
<%- include('../partials/nav') %>
<div class="container py-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center">
    <h3><%= product ? 'Malı redaktə et' : 'Yeni mal / İlkin mal qəbulu' %></h3>
    <% if (!product) { %>
    <a href="/products/bulk-new" class="btn btn-outline-secondary btn-sm">Siyahı ilə çoxlu mal əlavə et</a>
    <% } %>
  </div>
  <form method="post" action="<%= product ? '/products/' + product.id + '?_method=PUT' : '/products' %>" class="card p-4 mt-3">
    <div class="mb-3">
      <label class="form-label">Adı</label>
      <input type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" required>
    </div>
    <div class="row">
      <div class="col mb-3">
        <label class="form-label">Kateqoriya (könüllü)</label>
        <input type="text" name="category" class="form-control" value="<%= product && product.category ? product.category : '' %>" list="category-list" autocomplete="off">
        <datalist id="category-list">
          <% categories.forEach(c => { %><option value="<%= c %>"><% }) %>
        </datalist>
      </div>
      <div class="col mb-3">
        <label class="form-label">Alt kateqoriya (könüllü)</label>
        <input type="text" name="subCategory" class="form-control" value="<%= product && product.subCategory ? product.subCategory : '' %>" list="subcategory-list" autocomplete="off">
        <datalist id="subcategory-list">
          <% subCategories.forEach(c => { %><option value="<%= c %>"><% }) %>
        </datalist>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Barkod <span class="text-muted">(boş saxlasanız avtomatik yaradılır)</span></label>
      <input type="text" name="barcode" class="form-control" value="<%= product ? product.barcode : '' %>" <%= product ? 'required' : '' %>>
    </div>
    <div class="mb-3">
      <label class="form-label">Ölçü vahidi</label>
      <select name="unit" class="form-select">
        <option value="PIECE" <%= product && product.unit === 'PIECE' ? 'selected' : '' %>>Ədəd</option>
        <option value="KG" <%= product && product.unit === 'KG' ? 'selected' : '' %>>Çəki ilə (kq)</option>
      </select>
    </div>
    <div class="row">
      <div class="col mb-3">
        <label class="form-label">Alış qiyməti (₼)</label>
        <input type="number" step="0.01" min="0" name="purchasePrice" id="purchasePrice" class="form-control" value="<%= product ? product.purchasePrice : '' %>" required>
      </div>
      <div class="col mb-3">
        <label class="form-label">Satış qiyməti (₼)</label>
        <input type="number" step="0.01" min="0" name="salePrice" class="form-control" value="<%= product ? product.salePrice : '' %>" required>
      </div>
      <div class="col mb-3">
        <label class="form-label">Topdan satış qiyməti (₼)</label>
        <input type="number" step="0.01" min="0" name="wholesalePrice" id="wholesalePrice" class="form-control" value="<%= product ? product.wholesalePrice : '' %>" required>
        <% if (!product) { %><div class="form-text">Defolt: alış qiyməti + 15%, istəsəniz dəyişin.</div><% } %>
      </div>
    </div>
    <% if (product) { %>
    <div class="mb-3">
      <label class="form-label">Cari qalıq <span class="text-muted">(diqqətlə dəyişin — bu, anbar sayımı düzəlişi üçündür, adi mal qəbulu üçün "Mal qəbulu" düyməsini istifadə edin)</span></label>
      <input type="number" step="0.001" min="0" name="quantity" class="form-control" value="<%= product.quantity %>">
    </div>
    <% } %>
    <% if (!product) { %>
    <div class="row">
      <div class="col mb-3">
        <label class="form-label">İlkin miqdar</label>
        <input type="number" step="0.001" min="0" name="quantity" class="form-control" value="0" id="init-qty">
      </div>
      <div class="col mb-3">
        <label class="form-label">Təchizatçı (könüllü)</label>
        <input type="text" name="supplierName" class="form-control" list="supplier-list">
        <datalist id="supplier-list">
          <% suppliers.forEach(s => { %><option value="<%= s.name %>"><% }) %>
        </datalist>
      </div>
    </div>
    <div class="mb-3" id="paid-amount-wrap">
      <label class="form-label">Təchizatçıya ödənilən məbləğ (₼) <span class="text-muted">(boş saxlasanız tam ödənilib sayılır)</span></label>
      <input type="number" step="0.01" min="0" name="paidAmount" class="form-control" placeholder="tam">
    </div>
    <% } %>
    <div class="mb-3">
      <label class="form-label">Minimum qalıq xəbərdarlığı (könüllü)</label>
      <input type="number" step="0.001" min="0" name="minStock" class="form-control" value="<%= product && product.minStock ? product.minStock : '' %>">
    </div>
    <button type="submit" class="btn btn-primary">Yadda saxla</button>
  </form>
  <% if (!product) { %>
  <script>
    (function () {
      var purchaseInput = document.getElementById('purchasePrice');
      var wholesaleInput = document.getElementById('wholesalePrice');
      var wholesaleTouched = false;
      wholesaleInput.addEventListener('input', function () { wholesaleTouched = true; });
      purchaseInput.addEventListener('input', function () {
        if (wholesaleTouched) return;
        var p = parseFloat(purchaseInput.value);
        wholesaleInput.value = isNaN(p) ? '' : Math.round(p * 1.15 * 100) / 100;
      });
    })();
  </script>
  <% } %>
</div>
<%- include('../partials/foot') %>
