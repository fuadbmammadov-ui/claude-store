<%- include('../partials/head', { title: 'Təchizatçılar' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Təchizatçılar / Borclarımız</h3>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#new-supplier-modal">+ Yeni təchizatçı</button>
  </div>

  <form class="mb-3" method="get">
    <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Ad və ya nömrə üzrə axtar...">
  </form>

  <table class="table table-hover bg-white">
    <thead><tr><th>Ad</th><th>Telefon</th><th>Bizim borcumuz</th><th></th></tr></thead>
    <tbody>
      <% suppliers.forEach(s => { %>
      <tr>
        <td><a href="/suppliers/<%= s.id %>"><%= s.name %></a></td>
        <td><%= s.phone || '-' %></td>
        <td>
          <% if (s.outstanding > 0) { %>
            <span class="badge bg-danger debt-badge"><%= money(s.outstanding) %> ₼</span>
          <% } else { %>
            <span class="badge bg-success debt-badge">0.00 ₼</span>
          <% } %>
        </td>
        <td><a href="/suppliers/<%= s.id %>" class="btn btn-sm btn-outline-secondary">Ətraflı</a></td>
      </tr>
      <% }) %>
      <% if (!suppliers.length) { %>
      <tr><td colspan="4" class="text-center text-muted py-4">Təchizatçı tapılmadı</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="modal" id="new-supplier-modal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/suppliers">
        <div class="modal-header">
          <h5 class="modal-title">Yeni təchizatçı</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Ad</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Telefon</label>
            <input type="text" name="phone" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Qeyd</label>
            <textarea name="note" class="form-control"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Əlavə et</button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
