<%- include('../partials/head', { title: 'Mal üzrə mənfəət' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <h3>Mal üzrə satış və mənfəət</h3>
  <%- include('_subnav', { active: 'products' }) %>

  <div class="btn-group mb-3" role="group">
    <a href="?period=month" class="btn btn-sm <%= period === 'month' ? 'btn-primary' : 'btn-outline-primary' %>">Aylıq</a>
    <a href="?period=week" class="btn btn-sm <%= period === 'week' ? 'btn-primary' : 'btn-outline-primary' %>">Həftəlik</a>
  </div>

  <form method="get" class="d-flex gap-2 mb-4 flex-wrap" style="max-width: 500px;">
    <% if (period === 'week') { %>
    <input type="hidden" name="period" value="week">
    <input type="week" name="w" value="<%= wValue %>" class="form-control" style="max-width:180px;" onchange="this.form.submit()">
    <% } else { %>
    <input type="hidden" name="period" value="month">
    <select name="month" class="form-select" style="max-width:100px;" onchange="this.form.submit()">
      <% for (let m = 1; m <= 12; m++) { %>
      <option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %></option>
      <% } %>
    </select>
    <select name="year" class="form-select" style="max-width:110px;" onchange="this.form.submit()">
      <% for (let y = year - 2; y <= year + 1; y++) { %>
      <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
      <% } %>
    </select>
    <% } %>
    <select name="sort" class="form-select" style="max-width:200px;" onchange="this.form.submit()">
      <option value="revenue_desc" <%= sort === 'revenue_desc' ? 'selected' : '' %>>Satış məbləği (azalan)</option>
      <option value="margin_asc" <%= sort === 'margin_asc' ? 'selected' : '' %>>Margin % artan</option>
    </select>
  </form>

  <div class="table-responsive">
  <table class="table table-hover bg-white">
    <thead><tr><th>Mal</th><th>Satılan miqdar</th><th>Satış məbləği</th><th>Maya dəyəri</th><th>Mənfəət</th><th>Margin %</th></tr></thead>
    <tbody>
      <% rows.forEach(r => { %>
      <tr class="<%= r.marginPct < 10 ? 'table-danger' : r.marginPct < 15 ? 'table-warning' : '' %>">
        <td><%= r.name %></td>
        <td><%= qtyReport(r.qty, r.unit) %></td>
        <td><%= money(r.revenue) %> ₼</td>
        <td><%= money(r.cost) %> ₼</td>
        <td class="<%= r.profit >= 0 ? 'text-success' : 'text-danger' %>"><%= money(r.profit) %> ₼</td>
        <td><%= r.marginPct.toFixed(1) %>%</td>
      </tr>
      <% }) %>
      <% if (!rows.length) { %>
      <tr><td colspan="6" class="text-center text-muted py-4">Bu <%= period === 'week' ? 'həftədə' : 'ayda' %> satış yoxdur</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/foot') %>
