<%- include('../partials/head', { title: 'Sifarişlər' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Sifarişlər</h3>
    <a href="/orders/new" class="btn btn-primary">+ Yeni sifariş</a>
  </div>

  <ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link <%= status === '' ? 'active' : '' %>" href="/orders">Hamısı</a></li>
    <li class="nav-item"><a class="nav-link <%= status === 'DRAFT' ? 'active' : '' %>" href="/orders?status=DRAFT">Qaralama</a></li>
    <li class="nav-item"><a class="nav-link <%= status === 'CONFIRMED' ? 'active' : '' %>" href="/orders?status=CONFIRMED">Təsdiqlənib</a></li>
    <li class="nav-item"><a class="nav-link <%= status === 'CANCELLED' ? 'active' : '' %>" href="/orders?status=CANCELLED">Ləğv edilib</a></li>
  </ul>

  <div class="table-responsive">
  <table class="table table-hover bg-white">
    <thead><tr><th>#</th><th>Təchizatçı</th><th>Mal sayı</th><th>Cəmi</th><th>Status</th><th>Tarix</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><%= o.supplier ? o.supplier.name : (o.supplierName || '-') %></td>
        <td><%= o.itemCount %></td>
        <td><%= money(o.total) %> ₼</td>
        <td>
          <% if (o.status === 'DRAFT') { %><span class="badge bg-secondary">Qaralama</span>
          <% } else if (o.status === 'CONFIRMED') { %><span class="badge bg-success">Təsdiqlənib</span>
          <% } else { %><span class="badge bg-danger">Ləğv edilib</span><% } %>
        </td>
        <td><%= new Date(o.createdAt).toLocaleString('az-AZ') %></td>
        <td><a href="/orders/<%= o.id %>" class="btn btn-sm btn-outline-secondary">Ətraflı</a></td>
      </tr>
      <% }) %>
      <% if (!orders.length) { %>
      <tr><td colspan="7" class="text-center text-muted py-4">Sifariş tapılmadı</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/foot') %>
