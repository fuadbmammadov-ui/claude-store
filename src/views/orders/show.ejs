<%- include('../partials/head', { title: 'Sifariş #' + order.id }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>
      Sifariş #<%= order.id %>
      <% if (order.status === 'CONFIRMED') { %><span class="badge bg-success">Təsdiqlənib</span>
      <% } else { %><span class="badge bg-danger">Ləğv edilib</span><% } %>
    </h3>
    <a href="/orders" class="btn btn-outline-secondary btn-sm">← Sifarişlər</a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Təchizatçı</div><div class="fw-bold"><%= order.supplier ? order.supplier.name : (order.supplierName || '-') %></div></div></div>
    <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Yaradan</div><div class="fw-bold"><%= order.createdBy.fullName %></div></div></div>
    <% if (order.status === 'CONFIRMED') { %>
    <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Təsdiqləyən</div><div class="fw-bold"><%= order.confirmedBy ? order.confirmedBy.fullName : '-' %></div></div></div>
    <div class="col-md-3"><div class="card p-3"><div class="text-muted small">Təsdiq tarixi</div><div class="fw-bold"><%= new Date(order.confirmedAt).toLocaleString('az-AZ') %></div></div></div>
    <% } %>
  </div>

  <% if (order.note) { %><p class="text-muted">Qeyd: <%= order.note %></p><% } %>

  <div class="table-responsive">
  <table class="table table-sm bg-white">
    <thead><tr><th>Mal</th><th>Miqdar</th><th>Qiymət</th><th>Cəmi</th></tr></thead>
    <tbody>
      <% let total = 0; %>
      <% order.items.forEach(it => { %>
      <% const lineTotal = Number(it.quantity) * Number(it.purchasePrice); total += lineTotal; %>
      <tr>
        <td><%= it.productName %></td>
        <td><%= qty(it.quantity, it.unit) %> <%= it.unit === 'KG' ? 'kq' : 'ədəd' %></td>
        <td><%= money(it.purchasePrice) %> ₼</td>
        <td><%= money(lineTotal) %> ₼</td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr><th colspan="3" class="text-end">Cəmi</th><th><%= money(total) %> ₼</th></tr>
    </tfoot>
  </table>
  </div>

  <% if (order.status === 'CONFIRMED') { %>
  <p class="text-muted small">Bu sifariş təsdiqləndikdə mallar anbara əlavə olundu və təchizatçı adına borc yarandı.</p>
  <% } %>
</div>
<%- include('../partials/foot') %>
