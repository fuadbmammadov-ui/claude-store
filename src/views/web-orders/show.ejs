<%- include('../partials/head', { title: 'Sifariş #' + order.id }) %>
<%- include('../partials/nav') %>
<div class="container py-4" style="max-width: 720px;">
  <a href="/admin/web-orders" class="btn btn-outline-secondary btn-sm mb-3">&laquo; Siyahıya qayıt</a>

  <div class="card p-4">
    <div class="d-flex justify-content-between align-items-start">
      <h4>Sifariş #<%= order.id %></h4>
      <% if (order.status === 'PENDING') { %><span class="badge bg-warning text-dark fs-6">Yeni</span>
      <% } else if (order.status === 'CONFIRMED') { %><span class="badge bg-info text-dark fs-6">Təsdiqlənib</span>
      <% } else if (order.status === 'DELIVERED') { %><span class="badge bg-success fs-6">Çatdırılıb</span>
      <% } else { %><span class="badge bg-danger fs-6">Ləğv edilib</span><% } %>
    </div>
    <p class="text-muted">Tarix: <%= new Date(order.createdAt).toLocaleString('az-AZ') %></p>

    <hr>
    <h6>Müştəri məlumatları</h6>
    <p class="mb-1"><i class="bi bi-person"></i> <%= order.customerName %></p>
    <p class="mb-1"><i class="bi bi-telephone"></i> <a href="tel:<%= order.customerPhone %>"><%= order.customerPhone %></a></p>
    <% if (order.customerAddress) { %><p class="mb-1"><i class="bi bi-geo-alt"></i> <%= order.customerAddress %></p><% } %>
    <% if (order.note) { %><p class="mb-1"><i class="bi bi-chat-text"></i> <%= order.note %></p><% } %>

    <hr>
    <h6>Məhsullar</h6>
    <table class="table table-sm">
      <thead><tr><th>Məhsul</th><th>Miqdar</th><th>Qiymət</th><th>Cəmi</th></tr></thead>
      <tbody>
        <% order.items.forEach(it => { %>
        <tr>
          <td><%= it.productName %></td>
          <td><%= qty(it.quantity, it.unit) %> <%= it.unit === 'KG' ? 'kq' : 'ədəd' %></td>
          <td><%= money(it.unitPrice) %> ₼</td>
          <td><%= money(it.lineTotal) %> ₼</td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><th colspan="3" class="text-end">Cəmi</th><th><%= money(order.totalAmount) %> ₼</th></tr>
      </tfoot>
    </table>

    <hr>
    <h6>Statusu dəyiş</h6>
    <form method="post" action="/admin/web-orders/<%= order.id %>/status" class="d-flex gap-2">
      <select name="status" class="form-select">
        <option value="PENDING" <%= order.status === 'PENDING' ? 'selected' : '' %>>Yeni</option>
        <option value="CONFIRMED" <%= order.status === 'CONFIRMED' ? 'selected' : '' %>>Təsdiqlənib</option>
        <option value="DELIVERED" <%= order.status === 'DELIVERED' ? 'selected' : '' %>>Çatdırılıb</option>
        <option value="CANCELLED" <%= order.status === 'CANCELLED' ? 'selected' : '' %>>Ləğv edilib</option>
      </select>
      <button type="submit" class="btn btn-primary">Yadda saxla</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
