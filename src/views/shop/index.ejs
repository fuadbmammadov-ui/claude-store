<%- include('partials/head', { title: 'Mağaza' }) %>

<div class="container py-3">
  <form class="shop-search mb-3" method="get" action="/shop">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
      <input type="text" name="q" value="<%= q %>" class="form-control border-start-0" placeholder="Məhsul axtar...">
      <button type="submit" class="btn btn-outline-secondary">Axtar</button>
    </div>
  </form>

  <% if (categories.length) { %>
  <div class="shop-chips mb-3">
    <a href="/shop<%= q ? '?q=' + encodeURIComponent(q) : '' %>" class="shop-chip <%= !category ? 'active' : '' %>">Hamısı</a>
    <% categories.forEach(c => { %>
    <a href="/shop?category=<%= encodeURIComponent(c) %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="shop-chip <%= category === c ? 'active' : '' %>"><%= c %></a>
    <% }) %>
  </div>
  <% } %>

  <% if (!products.length) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-emoji-frown fs-1"></i>
    <p class="mt-2">Məhsul tapılmadı.</p>
  </div>
  <% } %>

  <div class="shop-grid">
    <% products.forEach(p => { %>
    <div class="shop-card">
      <a href="/shop/product/<%= p.id %>" class="shop-card-img-link">
        <% if (p.imageUrl) { %>
        <img src="<%= p.imageUrl %>" alt="<%= p.name %>" class="shop-card-img" onerror="this.closest('.shop-card').querySelector('.shop-card-img-link').classList.add('no-img'); this.remove();">
        <% } else { %>
        <div class="shop-card-img shop-card-img-placeholder"><i class="bi bi-image"></i></div>
        <% } %>
      </a>
      <div class="shop-card-body">
        <a href="/shop/product/<%= p.id %>" class="shop-card-title"><%= p.name %></a>
        <div class="shop-card-price"><%= money(p.salePrice) %> ₼<% if (p.unit === 'KG') { %> <span class="text-muted small">/ kq</span><% } %></div>
        <form method="post" action="/shop/cart/add" class="mt-2">
          <input type="hidden" name="productId" value="<%= p.id %>">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="returnTo" value="/shop<%= q || category ? '?' : '' %><%= q ? 'q=' + encodeURIComponent(q) : '' %><%= q && category ? '&' : '' %><%= category ? 'category=' + encodeURIComponent(category) : '' %>">
          <button type="submit" class="btn btn-sm shop-add-btn w-100"><i class="bi bi-cart-plus"></i> Səbətə əlavə et</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<%- include('partials/foot') %>
