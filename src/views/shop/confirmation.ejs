<%- include('partials/head', { title: 'Sifariş qəbul edildi' }) %>

<div class="container py-5 text-center" style="max-width: 560px;">
  <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
  <h3 class="mt-3">Sifarişiniz qəbul edildi!</h3>
  <p class="text-muted">Sifariş №<%= order.id %> &middot; Tezliklə sizinlə əlaqə saxlanılacaq.</p>

  <div class="shop-checkout-summary mt-4 text-start">
    <% order.items.forEach(it => { %>
    <div class="d-flex justify-content-between small py-1">
      <span><%= it.quantity %> × <%= it.productName %></span>
      <span><%= money(it.lineTotal) %> ₼</span>
    </div>
    <% }) %>
    <hr>
    <div class="d-flex justify-content-between fw-bold">
      <span>Cəmi</span>
      <span><%= money(order.totalAmount) %> ₼</span>
    </div>
  </div>

  <a href="/shop" class="btn shop-add-btn btn-lg w-100 mt-4">Mağazaya qayıt</a>
</div>

<%- include('partials/foot') %>
