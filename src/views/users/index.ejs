<%- include('../partials/head', { title: 'İstifadəçilər' }) %>
<%- include('../partials/nav') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>İstifadəçilər</h3>
    <a href="/users/new" class="btn btn-primary">+ Yeni istifadəçi</a>
  </div>
  <table class="table bg-white">
    <thead><tr><th>Ad</th><th>İstifadəçi adı</th><th>Rol</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% users.forEach(u => { %>
      <tr>
        <td><%= u.fullName %></td>
        <td><%= u.username %></td>
        <td><%= u.role === 'ADMIN' ? 'Admin' : 'Satıcı' %></td>
        <td><span class="badge <%= u.active ? 'bg-success' : 'bg-secondary' %>"><%= u.active ? 'Aktiv' : 'Deaktiv' %></span></td>
        <td class="text-end">
          <form action="/users/<%= u.id %>/toggle-active" method="post" class="d-inline">
            <button class="btn btn-sm btn-outline-secondary"><%= u.active ? 'Deaktiv et' : 'Aktivləşdir' %></button>
          </form>
          <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#reset-<%= u.id %>">Şifrəni sıfırla</button>
        </td>
      </tr>
      <div class="modal" id="reset-<%= u.id %>" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <form method="post" action="/users/<%= u.id %>/reset-password">
              <div class="modal-header">
                <h5 class="modal-title">Şifrəni sıfırla — <%= u.fullName %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <input type="password" name="password" class="form-control" placeholder="Yeni şifrə" required minlength="4">
              </div>
              <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Yadda saxla</button>
              </div>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/foot') %>
