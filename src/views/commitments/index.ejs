<%- include('../partials/head', { title: 'Öhdəliklər' }) %>
<%- include('../partials/nav') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3>Öhdəliklər — <%= monthLabel %></h3>
    <form method="post" action="/commitments/ensure">
      <input type="hidden" name="month" value="<%= monthValue %>">
      <button class="btn btn-outline-primary btn-sm">Ayı aç</button>
    </form>
  </div>

  <form method="get" class="mb-4" style="max-width: 220px;">
    <input type="month" name="month" value="<%= monthValue %>" class="form-control" onchange="this.form.submit()">
  </form>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Hesablanıb</div>
        <div class="fw-bold"><%= money(totals.hesablanib) %> ₼</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Ödənib</div>
        <div class="fw-bold text-success"><%= money(totals.odenib) %> ₼</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card p-3 text-center">
        <div class="text-muted small">Qalıq</div>
        <div class="fw-bold <%= totals.qalıq > 0 ? 'text-danger' : '' %>"><%= money(totals.qalıq) %> ₼</div>
      </div>
    </div>
  </div>

  <div class="table-responsive">
  <table class="table bg-white align-middle">
    <thead><tr><th>Ad</th><th>Qrup</th><th>Hesablanıb</th><th>Ödənib</th><th>Qalıq</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(r => { %>
      <tr>
        <td><%= r.commitment.name %></td>
        <td><%= r.commitment.group %></td>
        <td><%= money(r.hesablanib) %> ₼</td>
        <td><%= money(r.odenib) %> ₼</td>
        <td class="<%= r.qalıq > 0 ? 'text-danger' : '' %>"><%= money(r.qalıq) %> ₼</td>
        <td>
          <% if (r.status === 'ödənməyib') { %><span class="badge bg-danger">Ödənməyib</span>
          <% } else if (r.status === 'qismən') { %><span class="badge bg-warning text-dark">Qismən</span>
          <% } else { %><span class="badge bg-success">Ödənib</span><% } %>
        </td>
        <td class="d-flex gap-1">
          <% if (r.status !== 'ödənib') { %>
          <a class="btn btn-sm btn-primary" href="/expenses/new?commitmentId=<%= r.commitment.id %>">Ödə</a>
          <% } %>
          <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#edit-commitment-<%= r.commitment.id %>">Redaktə et</button>
        </td>
      </tr>
      <% }) %>
      <% if (!rows.length) { %>
      <tr><td colspan="7" class="text-center text-muted py-4">Bu ay üçün öhdəlik yoxdur</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>

<% rows.forEach(r => { %>
<div class="modal" id="edit-commitment-<%= r.commitment.id %>" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/commitments/<%= r.commitment.id %>?_method=PUT">
        <div class="modal-header">
          <h5 class="modal-title">Öhdəliyi redaktə et — <%= r.commitment.name %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Ad</label>
            <input type="text" name="name" class="form-control" value="<%= r.commitment.name %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Qrup</label>
            <select name="group" class="form-select">
              <% groups.forEach(g => { %><option value="<%= g %>" <%= g === r.commitment.group ? 'selected' : '' %>><%= g %></option><% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Məbləğ (₼)</label>
            <input type="number" step="0.01" min="0" name="amount" class="form-control" value="<%= r.commitment.amount %>" required>
            <div class="form-text">Bu, yalnız bu konkret öhdəliyi dəyişir — şablon və digər aylar təsirlənmir.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Yadda saxla</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% }) %>
<%- include('../partials/foot') %>
