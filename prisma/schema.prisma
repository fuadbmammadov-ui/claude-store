generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum Unit {
  PIECE
  KG
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  DEBT
  EXTERNAL
}

enum SaleStatus {
  PAID
  DEBT
}

enum ReceiptStatus {
  PAID
  DEBT
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  passwordHash     String
  fullName         String
  role             Role              @default(CASHIER)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  sales            Sale[]            @relation("SaleCashier")
  stockReceipts    StockReceipt[]
  cashSessions     CashSession[]
  debtPayments     DebtPayment[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  voidedSales      Sale[]            @relation("SaleVoidedBy")
}

model Product {
  id                Int            @id @default(autoincrement())
  name              String
  barcode           String         @unique
  category          String?
  subCategory       String?
  unit              Unit           @default(PIECE)
  purchasePrice     Decimal        @db.Decimal(12, 2)
  salePrice         Decimal        @db.Decimal(12, 2)
  quantity          Decimal        @db.Decimal(12, 3)
  minStock          Decimal?       @db.Decimal(12, 3)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  defaultSupplier   Supplier?      @relation(fields: [defaultSupplierId], references: [id])
  defaultSupplierId Int?
  saleItems         SaleItem[]
  stockReceipts     StockReceipt[]
}

model Supplier {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  phone         String?
  note          String?
  createdAt     DateTime          @default(now())
  products      Product[]
  stockReceipts StockReceipt[]
  payments      SupplierPayment[]
}

model StockReceipt {
  id               Int               @id @default(autoincrement())
  product          Product           @relation(fields: [productId], references: [id])
  productId        Int
  quantity         Decimal           @db.Decimal(12, 3)
  purchasePrice    Decimal           @db.Decimal(12, 2)
  totalAmount      Decimal           @db.Decimal(12, 2)
  paidAmount       Decimal           @db.Decimal(12, 2)
  status           ReceiptStatus     @default(PAID)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId       Int?
  supplierName     String?
  receivedBy       User              @relation(fields: [receivedById], references: [id])
  receivedById     Int
  createdAt        DateTime          @default(now())
  supplierPayments SupplierPayment[]
}

model SupplierPayment {
  id             Int          @id @default(autoincrement())
  stockReceipt   StockReceipt @relation(fields: [stockReceiptId], references: [id])
  stockReceiptId Int
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  supplierId     Int
  amount         Decimal      @db.Decimal(12, 2)
  method         PaymentType
  paidBy         User         @relation(fields: [paidById], references: [id])
  paidById       Int
  paidAt         DateTime     @default(now())
}

model Expense {
  id           Int         @id @default(autoincrement())
  category     String
  name         String
  amount       Decimal     @db.Decimal(12, 2)
  periodMonths Int         @default(1)
  method       PaymentType
  note         String?
  createdBy    User        @relation(fields: [createdById], references: [id])
  createdById  Int
  createdAt    DateTime    @default(now())
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String?
  note         String?
  createdAt    DateTime      @default(now())
  sales        Sale[]
  debtPayments DebtPayment[]
}

model Sale {
  id           Int           @id @default(autoincrement())
  customer     Customer?     @relation(fields: [customerId], references: [id])
  customerId   Int?
  cashier      User          @relation("SaleCashier", fields: [cashierId], references: [id])
  cashierId    Int
  paymentType  PaymentType
  totalAmount  Decimal       @db.Decimal(12, 2)
  paidAmount   Decimal       @db.Decimal(12, 2)
  status       SaleStatus
  note         String?
  createdAt    DateTime      @default(now())
  voided       Boolean       @default(false)
  voidedAt     DateTime?
  voidReason   String?
  voidedBy     User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidedById   Int?
  items        SaleItem[]
  debtPayments DebtPayment[]
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  sale          Sale    @relation(fields: [saleId], references: [id])
  saleId        Int
  product       Product @relation(fields: [productId], references: [id])
  productId     Int
  productName   String
  unit          Unit
  quantity      Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  discount      Decimal @db.Decimal(12, 2) @default(0)
  purchasePrice Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)
}

model DebtPayment {
  id           Int         @id @default(autoincrement())
  sale         Sale        @relation(fields: [saleId], references: [id])
  saleId       Int
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   Int
  amount       Decimal     @db.Decimal(12, 2)
  method       PaymentType
  receivedBy   User        @relation(fields: [receivedById], references: [id])
  receivedById Int
  paidAt       DateTime    @default(now())
}

model CashSession {
  id                  Int       @id @default(autoincrement())
  openedBy            User      @relation(fields: [openedById], references: [id])
  openedById          Int
  openingAmount       Decimal   @db.Decimal(12, 2)
  openedAt            DateTime  @default(now())
  closedAt            DateTime?
  closingAmountActual Decimal?  @db.Decimal(12, 2)
  note                String?
}
