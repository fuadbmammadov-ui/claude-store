DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SESSION_SECRET="change-this-to-a-long-random-string"
PORT=3000

# Satis olunanda Telegram bildirisi gondermek ucun (bos saxlasaniz bildiris gonderilmir)
TELEGRAM_BOT_TOKEN=""
# Bir neçe nefere getsin deye vergulle ayrilmis chat ID yazila biler, meselen: "111111,222222"
TELEGRAM_CHAT_ID=""

# Server acilisinda seed.js ve import-legacy.js skriptlerini yeniden ise salsin? (Render-de "true")
# Docker/Oracle-da build prosesi tam idare olundugu ucun adeten "false" saxlanila biler.
RUN_STARTUP_SCRIPTS="true"
